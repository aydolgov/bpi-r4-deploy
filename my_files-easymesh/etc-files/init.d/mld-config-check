#!/bin/sh /etc/rc.common

# Runs before mapagent (S97) so that, on a node whose configuration was wiped,
# mapagent starts with the AP-MLD section it needs instead of being restarted
# afterwards. See /usr/sbin/mld-config-check for what this recovers.
#
# Deliberately synchronous, unlike mld-link-check: the whole point is to finish
# before the next init script runs. It is a no-op on a healthy boot, so it
# costs nothing there.

START=96

start() {
	/usr/sbin/mld-config-check >/dev/null 2>&1
}

stop() {
	return 0
}
