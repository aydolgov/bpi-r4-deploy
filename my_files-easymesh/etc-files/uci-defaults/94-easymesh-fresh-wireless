#!/bin/sh
# Start every flash from a generated wireless config, not an inherited one.
#
# Why
# ---
# Every sysupgrade here runs keep-config, so a node carries its wireless config
# across generations and nothing ever removes a section. Measured 2026-07-28:
# 8g still held `bsta bsta-mld-1`, a name abandoned on 16 July, and x8 --
# flashed that morning -- held six sections naming interfaces it does not have.
#
# That is not cosmetic. map-agent's config_find_bsta_wireless() matches on
# mode="sta" alone and never looks at `disabled`, so a stale
# `default_sta_radio0 (ifname=wlan0, disabled=1)` counts as a live bSTA and is
# copied into mapagent by config_generate_bsta_agent(), which writes ifname,
# device and band but no priority. The interface never appears, leaving a
# section pointing at nothing, and the missing priority aborts an arithmetic
# test in /lib/wifi/multiap with "sh: out of range".
#
# Those default_sta_radio* sections have no generator left: not in the image,
# not in map_genconfig, not in the wifimngr or mapagent binaries. They are
# sediment, so deleting the file removes them for good rather than for a boot.
#
# Beyond the specific defect: measurements taken on a node carrying private
# history measure that history. A census of cold boots is only evidence if
# every node starts from the same place.
#
# How the config comes back
# -------------------------
# It is not rebuilt here -- at uci-defaults time (init.d/boot, START=10) the
# radios are not registered yet, so a detect would find nothing. Deletion is
# enough: when each phy appears, /etc/hotplug.d/ieee80211/10-wifi-detect runs
# `/sbin/wifi config` and 11-multiap-genconfig follows with the mesh sections.
# That is the same path a factory-fresh node takes.
#
# Kept: identity and policy -- system, network, ieee1905 (AL-MAC),
# mapcontroller, and mapagent's agent / controller_select / dynamic_backhaul /
# steer sections. controller_select.autostart in particular is what keeps a
# node from standing as a second controller, and it stays.
# Dropped: /etc/config/wireless, and the generated ap/bsta/mld sections in
# mapagent. SSIDs and keys come back from the controller over WSC.
#
# Numbered 94 so it runs before 99-drop-legacy-fronthaul, which edits the
# wireless config this script expects to be freshly generated.
#
# NOT for the production images: on a customer router this would throw away
# their Wi-Fi settings. Mesh nodes get theirs handed to them.

[ -x /lib/multiap/map_genconfig ] || exit 0     # not a mesh node

BACKUP_DIR=/etc/config-backup
STAMP="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo flash)"

mkdir -p "$BACKUP_DIR"
cp /etc/config/wireless "$BACKUP_DIR/wireless.$STAMP" 2>/dev/null
cp /etc/config/mapagent "$BACKUP_DIR/mapagent.$STAMP" 2>/dev/null
logger -t easymesh-fresh "kept $BACKUP_DIR/{wireless,mapagent}.$STAMP"

# Keep five generations; a node flashed twenty times should not spend its
# overlay on its own history.
ls -1t "$BACKUP_DIR"/wireless.* 2>/dev/null | tail -n +6 | while read -r f; do rm -f "$f"; done
ls -1t "$BACKUP_DIR"/mapagent.* 2>/dev/null | tail -n +6 | while read -r f; do rm -f "$f"; done

rm -f /etc/config/wireless
logger -t easymesh-fresh "wireless dropped, hotplug wifi-detect will regenerate it"

# Anonymous sections first, then the named ones map_genconfig writes
# (apmld0, apmld1, stamld0, bstamld0, bhmld_ap_5, bhmld_ap_6).
for t in ap bsta mld; do
	while uci -q delete "mapagent.@$t[0]" 2>/dev/null; do :; done
done

for s in $(uci show mapagent 2>/dev/null | sed -n 's/^mapagent\.\([A-Za-z_0-9]*\)=\(ap\|bsta\|mld\)$/\1/p'); do
	uci -q delete "mapagent.$s"
done

uci commit mapagent
logger -t easymesh-fresh "mapagent runtime sections cleared, identity kept"

exit 0
