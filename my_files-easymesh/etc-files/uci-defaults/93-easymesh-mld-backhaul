#!/bin/sh
# The MLO backhaul is opt-in, and the opt-in has to be in the image.
#
# map_genconfig generates the backhaul MLD only behind
#
#	[ "$(uci -q get mapagent.agent.mld_backhaul)" = "1" ] && {
#
# with the comment "Opt-in: without mld_backhaul=1 nothing". Nothing in the image
# sets that flag: it is absent from the map-agent package default
# (/rom/etc/config/mapagent), no script sets it, and no uci-default did until
# this one. It existed only in the running configuration - which is precisely the
# thing a flash starts over.
#
# So on the first boot after every flash, genconfig ran without it and produced a
# legacy, non-MLO configuration: no mld sections, no bhmld_ap_*, no mld_id.
# mld-report-check then regenerated everything and restarted map-agent about
# three minutes in, and that restart is not free - it costs a deauth/reassoc
# storm on every associated backhaul.
#
# Measured on the controller 2026-07-30, three flashes in a row, each with
# repairs=1. The fourth flash carried instrumentation that recorded what the
# watchdog actually saw at S99:
#
#	apmld0=missing  bhmld_ap_*.mld_id=missing
#	-- mapagent sections --
#	@radio[0] @ap[0] @radio[1] @ap[1] @ap[2] @radio[2] @ap[3] @ap[4] @ap[5]
#	-- mld_id options --        (none)
#	/etc/config/mapagent        mtime = boot + 30s
#
# Radios and AP sections present, every MLD trace absent, written half a minute
# into the boot. That is genconfig taking the legacy branch, not something
# deleting MLD configuration afterwards.
#
# Numbered 93 so it lands before 991-multiap-genconfig from the map-agent
# package, which is what actually reads the flag.
#
# A plain reboot never needed this - the flag survives in the configuration. It
# is the flash that reverts it, which is why three flashes repaired and one
# reboot did not.

# Zaznamenat stav PRED genconfigem.
#
# Tenhle skript bezi jako uci-default pred 991-multiap-genconfig, tedy v jedinem
# okamziku, kdy je videt, co po flashi zbylo, nez to genconfig prepsal. Vsechna
# dosavadni mereni byla az v S99 (mld-report-check), a to je o tri minuty pozde:
# /etc/config/mapagent uz je prepsany a jeho mtime patri genconfigu.
#
# Rozhoduje mezi dvema vyklady, ktere z pozdejsiho snimku rozlisit nejdou:
#   A) konfigurace flash prezila -> genconfig ji nemel regenerovat, a presto
#      MLD sekce zmizely
#   B) konfigurace flash neprezila -> genconfig regeneroval a MLD vetev se
#      netrefila
# Pocet radio sekci to rozhodne: 3 = A, 0 = B.
_ev=/etc/mapc/mld-report-evidence.log
mkdir -p /etc/mapc 2>/dev/null
{
	echo "=== PRED GENCONFIGEM  $(date '+%Y-%m-%d %H:%M:%S')  uptime $(cut -d. -f1 /proc/uptime)s ==="
	echo "radio sekci:  $(uci show mapagent 2>/dev/null | grep -c '=radio$')"
	echo "mld sekci:    $(uci show mapagent 2>/dev/null | grep -c '=mld$')"
	echo "ap sekci:     $(uci show mapagent 2>/dev/null | grep -c '=ap$')"
	echo "mld_backhaul: $(uci -q get mapagent.agent.mld_backhaul)"
	echo "apmld0:       $(uci -q get mapagent.apmld0 >/dev/null 2>&1 && echo present || echo missing)"
	echo "bhmld mld_id: $(uci show mapagent 2>/dev/null | grep -c 'bhmld_ap_[0-9]*\.mld_id=')"
	echo "wifi-device:  $(uci show wireless 2>/dev/null | grep -c '=wifi-device$')"
	echo "mt76 modul:   $([ -d /sys/module/mt76 ] && echo ano || echo NE)"
	echo "phy:          $(ls /sys/class/ieee80211/ 2>/dev/null | tr '\n' ' ')"
	echo "mapagent mtime: $(ls -la /etc/config/mapagent 2>/dev/null)"
	echo
} >> "$_ev" 2>&1

uci -q get mapagent.agent >/dev/null 2>&1 || uci set mapagent.agent=agent

[ "$(uci -q get mapagent.agent.mld_backhaul)" = "1" ] || {
	uci set mapagent.agent.mld_backhaul='1'
	uci commit mapagent
	logger -t easymesh-seed "seeded mapagent.agent.mld_backhaul=1 before genconfig"
}

exit 0
