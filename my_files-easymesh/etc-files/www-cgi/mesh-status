#!/bin/sh
# mesh-status - a plain page showing what the controller actually knows.
#
# Deliberately not the WebUI from docs/design/webui-shape-2026-07-21.md. That
# one is for the owner of a mesh and has to be designed. This is for us: no
# framework, no build step, no LuCI integration - a CGI script that asks the
# database and prints the answer.
#
# Human layer (2026-07-23): nodes and clients are shown by NAME, not MAC.
# Node names come from /etc/mesh-node-names ("<al-mac> <name>" per line) so
# other identification can be added later without touching this script; a MAC
# with no entry falls back to the raw MAC. Clients use their DHCP hostname.
# The MAC-level inventory below is unchanged - that is for us, the names for you.
#
# Install: /www/cgi-bin/mesh-status on the controller.
#          http://<controller>/cgi-bin/mesh-status

DB=/etc/mapc/mapc.db
NAMES=/etc/mesh-node-names

q() { sqlite3 "$DB" "$1" 2>/dev/null; }
dash() { [ -n "$1" ] && printf '%s' "$1" || printf '<span class=na>&mdash;</span>'; }

# AL-MAC -> friendly node name. Extend by editing /etc/mesh-node-names.
node_name() {
	[ -n "$1" ] || { printf '<span class=na>&mdash;</span>'; return; }
	n=$(awk -v m="$1" 'BEGIN{IGNORECASE=1} $1==m {print $2; exit}' "$NAMES" 2>/dev/null)
	if [ -n "$n" ]; then printf '%s <span class="sub mac">%s</span>' "$n" "$1"
	else printf '<span class=mac>%s</span>' "$1"; fi
}

band_name() {
	case "$1" in
		1) echo "2.4 GHz" ;;  2) echo "5 GHz" ;;  8) echo "6 GHz" ;;
		"") echo "<span class=na>&mdash;</span>" ;;
		*) echo "band $1" ;;
	esac
}

# "1,8,2" -> "2.4 + 5 + 6 GHz". Sorted numerically so the order is the band
# order and not whatever group_concat happened to emit.
bands_name() {
	[ -n "$1" ] || { printf '<span class=na>&mdash;</span>'; return; }
	printf '%s' "$1" | tr ',' '\n' | sort -n | uniq | while read -r b; do
		case "$b" in 1) printf '2.4 + ' ;; 2) printf '5 + ' ;; 8) printf '6 + ' ;;
			     '') : ;; *) printf 'band%s + ' "$b" ;; esac
	done | sed 's/ + $/ GHz/'
}

yn() {
	case "$1" in
		1) echo '<span class=ok>yes</span>' ;;
		0) echo 'no' ;;
		*) echo '<span class=na>&mdash;</span>' ;;
	esac
}

REFRESH=""
case "$QUERY_STRING" in
	*refresh=*) REFRESH=$(echo "$QUERY_STRING" | sed -n 's/.*refresh=\([0-9]\{1,4\}\).*/\1/p') ;;
esac

printf 'Content-Type: text/html; charset=utf-8\r\n\r\n'

echo '<!DOCTYPE html><html><head><meta charset="utf-8">'
[ -n "$REFRESH" ] && echo "<meta http-equiv=\"refresh\" content=\"$REFRESH\">"
cat <<'EOF'
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>EasyMesh</title>
<style>
 body{font:14px/1.55 -apple-system,system-ui,sans-serif;margin:2rem auto;max-width:62rem;
      padding:0 1rem;color:#111;background:#fff}
 h1{font-size:1.35rem;margin:0 0 .2rem}
 h2{font-size:1rem;margin:2.2rem 0 .5rem;font-weight:600}
 .sub{color:#777;font-size:.88rem}
 .note{color:#777;font-size:.85rem;margin:.4rem 0 0}
 table{border-collapse:collapse;width:100%;margin:.6rem 0}
 th,td{text-align:left;padding:.35rem .55rem;border-bottom:1px solid #ececec;
       vertical-align:top}
 th{color:#666;font-weight:600;font-size:.82rem;white-space:nowrap}
 .mac,.num{font-family:ui-monospace,Menlo,monospace;font-size:.82rem}
 .sub.mac{font-size:.72rem}
 .ok{color:#0a7d28}.warn{color:#b26a00}.bad{color:#c0392b}.na{color:#bbb}
 .grp{font-weight:600;padding-top:.9rem}
 .big td{font-size:1rem;padding:.5rem .55rem}
 .dev{font-weight:600}
 .bar{display:inline-block;height:.55rem;border-radius:2px;vertical-align:middle}
 .bf{background:#0a7d28}.be{background:#ddd}
 @media (prefers-color-scheme:dark){
   body{background:#111;color:#eee} th{color:#999} .sub,.note{color:#888}
   th,td{border-bottom-color:#282828} .na{color:#555} .be{background:#333}
 }
</style></head><body>
EOF

echo "<h1>EasyMesh</h1>"
printf '<div class=sub>controller %s &middot; %s &middot; ' "$(cat /proc/sys/kernel/hostname)" "$(date)"
if [ -n "$REFRESH" ]; then
	printf 'auto-refresh %s s &middot; <a href="?">stop</a></div>\n' "$REFRESH"
	cat <<'EOF'
<script>
 addEventListener('beforeunload',function(){sessionStorage.setItem('y',scrollY)});
 addEventListener('load',function(){var y=sessionStorage.getItem('y');if(y)scrollTo(0,+y)});
</script>
EOF
else
	printf '<a href="?refresh=15">auto-refresh</a></div>\n'
fi

# ------------------------------------------------------------------ health
# Roles first. Two controllers invalidate everything else on this page: on
# 2026-07-24 topology, depth, MLD counts and steering all looked broken at once
# and each symptom was chased separately for days, when there was one cause.
#
# HEURISTIC, and said so below. A controller cannot reliably see a second
# controller that never onboarded to it; what it can see is a node that is
# present but never registered as an agent, which is how the rogue showed up.
# Ground truth is per node - mesh-env reports whether a controller runs there.
echo "<h2>Health &mdash; roles</h2>"
_nodes=$(q "select count(*) from agent;")
_notagent=$(q "select count(*) from agent where is_agent=0;")
echo "<table><tr><th>check<th>result</tr>"
echo "<tr><td>nodes in database<td>$(dash "$_nodes")</tr>"
if [ "${_notagent:-0}" -gt 0 ]; then
	echo "<tr><td>present but not registered as agent<td><b>$_notagent</b> &mdash; possible second controller</tr>"
else
	echo "<tr><td>present but not registered as agent<td>0</tr>"
fi
echo "</table>"
echo "<p class=note>Heuristic. Controller and agent are not exclusive - a"
echo "controller normally runs an agent too, so a node calling itself an agent"
echo "may still be running a controller, and this page cannot see one that never"
echo "onboarded here. Run <code>mesh-env</code> on each node for the real answer.</p>"

# ----------------------------------------------------------------- clients
# Which device is connected to which node. Real clients only - the node-to-node
# backhaul gets its own section below, from a table that is actually right.
#
# Two things this section used to get wrong, both fixed 2026-08-02:
#
#   * It printed the band of whatever single BSS matched sta.bssid. For an MLO
#     client that is nonsense: the MLD address usually equals link 0's BSSID, so
#     a client happily using 6 GHz was reported as "2.4 GHz". If the BSSID is an
#     AP-MLD we now say so and list every affiliated band.
#   * It mixed backhaul links in with clients. They are mesh plumbing, they
#     outnumber the clients, and sourcing them from `sta` was the reason the
#     whole list went blank after a controller restart (see below).
#   * It counted one MLO client as several devices. Each affiliated link of
#     an MLD gets its own row in `sta` under its own address, so the iPhone on
#     2026-08-03 appeared four times - once per link plus the MLD itself - and
#     the page said "5 client device(s)" when two were present, one of them a
#     ghost. affiliated_sta maps every link address to its MLD, so a row that
#     appears there is a leg, not a device, and is folded away here.
#   * The count came from `sta` alone, so it counted rows this page folds away
#     and missed the live client entirely - on 2026-08-03 it said 4 while one
#     phone was connected, because that phone is known only to sta_mld. Both
#     loops below now count what they actually print.
#   * A row with no timestamp cannot be shown as connected, and iOS mints a new
#     address on every join, so the list grew by one dead row per roam. They are
#     folded into a single line - with their addresses still on it, because a
#     row this page cannot verify is not the same as a row worth hiding.
echo "<h2>Clients &mdash; who is connected where</h2>"
STADIR=/tmp/mesh-status.$$
mkdir -p "$STADIR"; : > "$STADIR/live"; : > "$STADIR/dead"
trap 'rm -rf "$STADIR"' EXIT
NSTA=$(q "SELECT count(*) FROM sta WHERE COALESCE(is_bsta,0)=0
                  AND macaddr NOT IN (SELECT macaddr FROM affiliated_sta)")
NSTA=$(( ${NSTA:-0} + $(q "SELECT count(*) FROM sta_mld
                            WHERE mld_macaddr NOT IN (SELECT macaddr FROM sta)") ))
if [ "${NSTA:-0}" = "0" ]; then
	echo "<p class=note>No client devices. Backhaul links are listed separately below.</p>"
else
	echo "<table class=big><tr><th>device<th>connected to<th>band<th>state<th>last heard</tr>"
	q "SELECT COALESCE(NULLIF(s.hostname,''), s.macaddr), s.agent_almac, s.associated,
	          (SELECT count(*) FROM apmld m WHERE m.mld_macaddr = s.bssid),
	          COALESCE(s.conn_time,0),
	          (SELECT group_concat(DISTINCT r.band) FROM affiliated_ap a
	             JOIN radio r ON r.ruid = a.ruid WHERE a.mld_macaddr = s.bssid),
	          (SELECT r.band FROM bss b JOIN radio r ON r.ruid=b.ruid WHERE b.bssid=s.bssid LIMIT 1),
	          (SELECT strftime('%s','now') - m.last_seen FROM sta_mld m
	             WHERE m.mld_macaddr = s.macaddr),
	          (SELECT p.agent_almac FROM sta_mld m JOIN apmld p ON p.mld_macaddr = m.ap_mld_macaddr
	             WHERE m.mld_macaddr = s.macaddr)
	   FROM sta s WHERE COALESCE(s.is_bsta,0)=0
	     AND s.macaddr NOT IN (SELECT macaddr FROM affiliated_sta)
	   ORDER BY s.hostname, s.macaddr" |
	while IFS='|' read -r name agent assoc ismld conn mldbands band age mldagent; do
		# A client sitting on an MLD's primary link has that MLD's address as
		# its BSSID, so "the BSSID is an AP-MLD" does not make it an MLO
		# client. Measured 2026-08-04: b8:09:8a:50:f2:2a reported
		# mlo_capable false on a single link and this page still called it
		# MLO. Only a sta_mld row - which is also what "last heard" comes
		# from - says the client really has more than one leg.
		if [ "${ismld:-0}" != "0" ] && [ -n "$mldbands" ] && [ -n "$age" ]; then
			bandtxt="<span class=ok>MLO</span> &middot; $(bands_name "$mldbands")"
		elif [ "${ismld:-0}" != "0" ] && [ -n "$mldbands" ]; then
			bandtxt="$(bands_name "$mldbands") <span class=sub>on AP-MLD</span>"
		else
			bandtxt=$(band_name "$band")
		fi

		# Two tables can name a different node for the same client, and on
		# 2026-08-03 the MLD one was right while sta was a roam behind -
		# steering read sta, aimed at the node the client had left, and the
		# agent rejected it. Show the fresher answer, and say when they differ.
		where=$(node_name "$agent")
		if [ -n "$mldagent" ] && [ "$mldagent" != "$agent" ]; then
			where="$(node_name "$mldagent") <span class=warn>(sta says $(node_name "$agent"))</span>"
		fi

		# sta keeps clients for stale_sta_timeout, which is 20 days here, so
		# "connected" alone says nothing about now. Two things can support it:
		# a sta_mld timestamp, or conn_time - which the controller only fills
		# once an agent has actually reported the client. Measured 2026-08-04:
		#
		#   b8:09:8a:50:f2:2a  conn_time 586  rcpi 138  pkts_rx 5820   <- live
		#   1a:37:b1:44:c0:70  conn_time   0  rcpi   0  pkts_rx    0   <- ghost
		#
		# Judging on sta_mld alone was wrong in both directions: it folded away
		# a non-MLO client that was demonstrably connected (it has no MLD row
		# and never will) and it promoted a ten-hour-old MLD record as the one
		# device with evidence behind it.
		if [ -z "$age" ] && [ "${conn:-0}" -le 0 ] 2>/dev/null; then
			printf '%s\n' "$name" >> "$STADIR/dead"
			continue
		fi
		if [ -z "$age" ]; then
			agetxt='<span class=na>&mdash;</span>'
		elif [ "$age" -lt 90 ] 2>/dev/null; then
			agetxt="<span class=ok>${age}s</span>"
		else
			agetxt="<span class=warn>${age}s</span>"
		fi

		# The "unverified" state that used to live here is gone: a row with
		# nothing behind it is folded away above rather than printed with a
		# caveat, so everything here has either an age or a conn_time.
		state=$([ "$assoc" = "1" ] && echo '<span class=ok>connected</span>' || echo 'left')
		if [ "$assoc" = "1" ] && [ -n "$age" ] && [ "$age" -ge 300 ] 2>/dev/null; then
			state='<span class=warn>stale</span>'
		fi
		[ "${conn:-0}" -gt 0 ] 2>/dev/null && state="$state <span class=sub>${conn}s</span>"

		printf '<tr><td>%s<td>%s<td>%s<td>%s<td class=num>%s</tr>\n' \
			"<span class=dev>$name</span>" "$where" "$bandtxt" "$state" "$agetxt"
		printf '%s\n' "$name" >> "$STADIR/live"
	done

	# An MLO client can be known to sta_mld and absent from sta - they are
	# keyed differently and iOS rotates its per-network address, so the two
	# tables end up describing different MACs for the same phone. Listing
	# only sta hides a client the controller demonstrably knows about.
	q "SELECT m.mld_macaddr, strftime('%s','now') - m.last_seen, p.agent_almac, m.num_sta
	   FROM sta_mld m LEFT JOIN apmld p ON p.mld_macaddr = m.ap_mld_macaddr
	   WHERE m.mld_macaddr NOT IN (SELECT macaddr FROM sta)
	   ORDER BY m.mld_macaddr" |
	while IFS='|' read -r mac age owner nsta; do
		[ -n "$mac" ] || continue
		# An MLD record with no time, or one that has not been heard from in
		# five minutes, is a client that left - iOS rotates its address on
		# every join, so these accumulate. Fold them with the rest.
		if [ -z "$age" ] || [ "$age" -ge 300 ] 2>/dev/null; then
			printf '%s\n' "$mac" >> "$STADIR/dead"
			continue
		fi
		if [ "$age" -lt 90 ] 2>/dev/null; then
			agetxt="<span class=ok>${age}s</span>"
		else
			agetxt="<span class=warn>${age}s</span>"
		fi
		printf '<tr><td>%s<td>%s<td>%s<td>%s<td class=num>%s</tr>\n' \
			"<span class=dev><span class=mac>$mac</span></span>" \
			"$(node_name "$owner")" \
			"<span class=ok>MLO</span> &middot; $(dash "$nsta") link(s)" \
			"<span class=warn>MLD only</span>" "$agetxt"
		printf '%s\n' "$mac" >> "$STADIR/live"
	done

	# One line for everything with no timestamp, addresses included. Before
	# this, each iOS address rotation left another row that read "connected"
	# and the list only ever grew.
	NDEAD=$(wc -l < "$STADIR/dead" 2>/dev/null | tr -d ' ')
	if [ "${NDEAD:-0}" -gt 0 ] 2>/dev/null; then
		printf '<tr><td colspan=5><span class=warn>%s departed record(s)</span> <span class="sub mac">%s</span></td></tr>\n' \
			"$NDEAD" "$(tr '\n' ' ' < "$STADIR/dead")"
	fi
	echo "</table>"
fi
NLIVE=$(wc -l < "$STADIR/live" 2>/dev/null | tr -d ' ')
printf '<p class=note>%s client device(s) the controller has evidence for, %s departed record(s) folded into the last row. Names come from DHCP; unknown ones show their MAC. Evidence is a sta_mld timestamp (&quot;last heard&quot;) or a non-zero conn_time, which the controller fills only once an agent reports the client - a non-MLO client has no MLD row and is judged on conn_time alone. Rows with neither, and MLD records not heard from in 300 s, are folded away rather than shown as connected: sta keeps departed clients for 20 days by design.</p>\n' "${NLIVE:-0}" "${NDEAD:-0}"

# --------------------------------------------------------------- backhaul
# Node-to-node links, from topology_link rather than from `sta`.
#
# `sta` is filled from association events, so a controller that restarts while
# the backhauls are already up never learns about them and the rows never
# appear - measured 2026-08-02, the list sat empty with all three nodes meshed
# and passing traffic. topology_link is rebuilt from Topology Responses and was
# correct throughout, including the hop count that `sta` cannot express at all.
echo "<h2>Backhaul &mdash; how the nodes reach the controller</h2>"
if [ "$(q "SELECT count(*) FROM topology_link")" = "0" ]; then
	echo "<p class=note>No node-to-node links recorded.</p>"
else
	echo "<table><tr><th>node<th>connects through<th>hops<th>depth</tr>"
	q "SELECT child_almac, parent_almac, COALESCE(wifi_hops,''), COALESCE(depth,'')
	   FROM topology_link ORDER BY depth, child_almac" |
	while IFS='|' read -r child parent hops depth; do
		printf '<tr><td>%s<td>%s<td class=num>%s<td class=num>%s</tr>\n' \
			"$(node_name "$child")" "$(node_name "$parent")" \
			"$(dash "$hops")" "$(dash "$depth")"
	done
	echo "</table>"
	echo "<p class=note>Depth 1 is a direct neighbour of the controller. A node at depth 2 reaches it through another agent, which costs latency and makes it the first to suffer when the relay wobbles.</p>"
fi

# ------------------------------------------------------------------- nodes
echo "<h2>Nodes</h2><table><tr><th>node<th>role<th>depth<th>radios<th>BSS<th>backhaul<th>upstream</tr>"
HAVE_VIEW=$(q "SELECT count(*) FROM sqlite_master WHERE type='view' AND name='agent_backhaul'")
if [ "$HAVE_VIEW" = "1" ]; then
	SEL="SELECT a.almac, CASE WHEN ab.depth=0 THEN 'controller' ELSE 'agent' END, ab.depth,
	     (SELECT count(*) FROM radio r WHERE r.agent_almac=a.almac),
	     (SELECT count(*) FROM bss b JOIN radio r ON r.ruid=b.ruid WHERE r.agent_almac=a.almac),
	     ab.backhaul_band, ab.backhaul_upstream_al
	     FROM agent a LEFT JOIN agent_backhaul ab ON ab.almac=a.almac
	     ORDER BY ab.depth, a.almac"
else
	SEL="SELECT a.almac, CASE WHEN a.depth=0 THEN 'controller' ELSE 'agent' END, a.depth,
	     (SELECT count(*) FROM radio r WHERE r.agent_almac=a.almac),
	     (SELECT count(*) FROM bss b JOIN radio r ON r.ruid=b.ruid WHERE r.agent_almac=a.almac),
	     NULL, (SELECT t.parent_almac FROM topology_link t WHERE t.child_almac=a.almac)
	     FROM agent a ORDER BY a.depth, a.almac"
fi
q "$SEL" | while IFS='|' read -r almac role depth radios bsses band up; do
	printf '<tr><td>%s<td>%s<td class=num>%s<td class=num>%s<td class=num>%s<td>%s<td>%s</tr>\n' \
		"$(node_name "$almac")" "$role" "$(dash "$depth")" "$(dash "$radios")" "$(dash "$bsses")" \
		"$(band_name "$band")" "$([ -n "$up" ] && node_name "$up" || dash "")"
done
echo "</table>"
[ "$HAVE_VIEW" = "1" ] || echo "<p class=note>The agent_backhaul view is not in this database yet (patch 973), so the backhaul band is unavailable.</p>"

# ------------------------------------------------------------------ radios
echo "<h2>Radios and Wi-Fi 7 capabilities</h2>"
echo "<table><tr><th>node<th>band<th>EMLSR<th>STR<th>NSTR<th>EMLMR<th>EHT caps</tr>"
q "SELECT r.agent_almac, r.band, c.wifi7_emlsr, c.wifi7_str,
          c.wifi7_nstr, c.wifi7_emlmr, c.eht_caps
   FROM radio r LEFT JOIN radio_caps c ON c.ruid=r.ruid
   ORDER BY r.agent_almac, r.band" |
while IFS='|' read -r agent band emlsr str nstr emlmr eht; do
	printf '<tr><td>%s<td>%s<td>%s<td>%s<td>%s<td>%s<td>%s</tr>\n' \
		"$(node_name "$agent")" "$(band_name "$band")" \
		"$(yn "$emlsr")" "$(yn "$str")" "$(yn "$nstr")" "$(yn "$emlmr")" "$(dash "$eht")"
done
echo "</table>"

# --------------------------------------------------------------------- MLD
# The heading used to say "fronthaul", but half these rows are the backhaul MLD
# (SSID MAP--BH) - and that one is the interesting one here, because a node with
# both rows is a node carrying mesh traffic over Wi-Fi 7 rather than a single
# link. Role is taken from bss.is_fbss/is_bbss of the affiliated links rather
# than from the SSID string, so a renamed backhaul SSID does not mislabel it.
echo "<h2>AP-MLD (Wi-Fi 7)</h2><table><tr><th>node<th>SSID<th>role<th>enabled<th>affiliated links<th>TTLM rows</tr>"
q "SELECT m.agent_almac, m.ssid, m.enabled,
          (SELECT count(*) FROM affiliated_ap f WHERE f.mld_macaddr=m.mld_macaddr),
          (SELECT count(*) FROM ttlm t WHERE t.mld_macaddr=m.mld_macaddr),
          (SELECT CASE WHEN max(b.is_bbss)=1 AND max(b.is_fbss)=1 THEN 'both'
                       WHEN max(b.is_bbss)=1 THEN 'backhaul'
                       WHEN max(b.is_fbss)=1 THEN 'fronthaul'
                       ELSE '' END
             FROM affiliated_ap f JOIN bss b ON b.bssid=f.bssid
            WHERE f.mld_macaddr=m.mld_macaddr)
   FROM apmld m ORDER BY m.agent_almac, m.ssid" |
while IFS='|' read -r agent ssid en aps ttlm role; do
	case "$role" in
		backhaul)  roletxt='<span class=ok>backhaul</span>' ;;
		fronthaul) roletxt='fronthaul' ;;
		both)      roletxt='<span class=warn>both</span>' ;;
		*)         roletxt=$(dash "") ;;
	esac
	printf '<tr><td>%s<td>%s<td>%s<td>%s<td class=num>%s<td class=num>%s</tr>\n' \
		"$(node_name "$agent")" "$(dash "$ssid")" "$roletxt" \
		"$(yn "$en")" "$(dash "$aps")" "$(dash "$ttlm")"
done
echo "</table>"

# ---------------------------------------------------------------- coverage
# Some node settings live in the U-Boot environment, not in uci: netmode (drives
# whether genconfig emits MLD affiliation or legacy per-radio fronthauls),
# owrt_country and disable_mlo. They are per unit, survive every sysupgrade, and
# no EasyMesh TLV carries them, so this page cannot show them for the agents -
# only the node itself can. Point at the tool instead of pretending otherwise.
echo "<h2>Settings outside uci</h2>"
echo "<p class=note>netmode, owrt_country and disable_mlo live in the U-Boot"
echo "environment. They change how a node behaves, appear in no uci dump, are per"
echo "unit and survive sysupgrade -n. No TLV carries them, so run"
echo "<code>mesh-env</code> on the node you are asking about.</p>"
echo "<table><tr><th>this controller<th>value</tr>"
for v in netmode owrt_country disable_mlo; do
	val=$(fw_printenv -n "$v" 2>/dev/null)
	echo "<tr><td><code>$v</code><td>$(dash "$val")</tr>"
done
echo "</table>"

echo "<h2>Raw tables (for us)</h2>"
echo "<p class=note>The MAC-level inventory: one line per table, how many of its"
echo "columns ever hold a value. This is the debug view - the sections above are"
echo "the human one.</p>"
echo "<table><tr><th>table<th>rows<th>columns with data<th></th><th>empty</tr>"

for t in $(q "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name"); do
	rows=$(q "SELECT count(*) FROM \"$t\"")
	cols=$(q "PRAGMA table_info(\"$t\")" | cut -d'|' -f2)
	ncols=$(echo "$cols" | wc -w)

	if [ "${rows:-0}" -eq 0 ] 2>/dev/null; then
		printf '<tr><td>%s<td class="num warn">0<td colspan=3 class=sub>table is empty</tr>\n' "$t"
		continue
	fi

	nfull=0; empties=""; detail=""
	for c in $cols; do
		filled=$(q "SELECT count(*) FROM \"$t\" WHERE \"$c\" IS NOT NULL AND \"$c\" != ''")
		ex=$(q "SELECT \"$c\" FROM \"$t\" WHERE \"$c\" IS NOT NULL AND \"$c\" != '' LIMIT 1" | cut -c1-24)
		if [ "$filled" -eq 0 ]; then
			empties="${empties}${empties:+, }$c"
			detail="${detail}<tr><td>&nbsp;&nbsp;<span class=warn>$c</span><td class=\"num warn\">0/$rows<td colspan=2 class=sub>never written</tr>"
		else
			nfull=$(( nfull + 1 ))
			detail="${detail}<tr><td>&nbsp;&nbsp;$c<td class=\"num ok\">$filled/$rows<td colspan=2 class=num>$(dash "$ex")</tr>"
		fi
	done

	w=$(( nfull * 60 / ncols ))
	[ "$nfull" -eq "$ncols" ] && cls=ok || cls=warn
	printf '<tr><td>%s<td class=num>%s<td class="num %s">%s/%s' "$t" "$rows" "$cls" "$nfull" "$ncols"
	printf '<td><span class="bar bf" style="width:%spx"></span><span class="bar be" style="width:%spx"></span>' \
		"$w" "$(( 60 - w ))"
	if [ -n "$empties" ]; then
		printf '<td class=sub>%s</tr>\n' "$empties"
	else
		printf '<td class=ok>&mdash;</tr>\n'
	fi
	printf '<tr><td colspan=5><details><summary class=sub>all %s columns</summary><table>%s</table></details></tr>\n' \
		"$ncols" "$detail"
done
echo "</table>"

echo "</body></html>"
