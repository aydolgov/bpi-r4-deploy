#!/bin/sh
# mesh-gwd - the internet gateway follows the cable.
#
# Plug the ISP cable into ANY node and the whole mesh goes online; move it
# to another node and it goes online again, without touching a single
# client. The mesh is one L2 domain, so this is the classic VRRP setup a
# wired LAN would use - keepalived would be the standard answer, but it
# needs kmod-macvlan and kernel modules from the OpenWrt repo do not match
# our MTK-feed kernel. Our case is also narrower than VRRP: the node that
# owns the cable owns the address, and nothing else competes for it.
#
# The clients' gateway is a virtual address (VIP) that lives on whichever
# node currently has a working uplink:
#
#   have uplink  -> claim VIP, enable NAT, announce with gratuitous ARP
#   lost uplink  -> release VIP, disable NAT, let another node take over
#
# Measured 2026-08-05: moving the VIP between two nodes cost zero pings
# (75 probes at 0.1 s, no gap) - the announce is what makes it seamless.
#
# Deliberately NOT done here: nothing touches wifi, the backhaul or the
# mesh itself. The worst failure mode is "no internet", never "no mesh".
VIP=${VIP:-10.10.10.254}
LAN=${LAN:-br-lan}
WAN_IF=${WAN_IF:-wan}
PROBE=${PROBE:-1.1.1.1}
# Legacy static gateway to clear on takeover (pre-VIP deployments).
GW_FALLBACK=${GW_FALLBACK:-10.10.10.1}
PERIOD=${PERIOD:-3}
# Hysteresis. Handing the gateway over is disruptive and unplugging a cable
# is rare, so the daemon should be slow to believe the uplink died: four
# consecutive failed probes, i.e. ~12 s of silence, not one lost packet.
FAILS_TO_DROP=${FAILS_TO_DROP:-4}

log() { logger -t mesh-gwd "$1"; echo "$(date +%T) $1"; }

have_vip() { ip -4 addr show dev "$LAN" | grep -q "inet $VIP/"; }

# "Do I have a way out THROUGH MY OWN CABLE?" - three conditions, cheapest
# first. The probe MUST be sourced from the WAN address: every node reaches
# the internet through the mesh already, so an unbound ping would answer
# "yes" on a node whose WAN port holds nothing but a dead switch - and two
# nodes would then both claim to be the gateway.
uplink_ok() {
	# Ask the system which device carries the WAN instead of assuming a
	# name: it is br-wan on the classic boards and eth1 on the Pro 8X,
	# and it will be wwan0 the day someone plugs in an LTE module.
	# Hard-coding "wan" made a Pro 8X with a live cable and an ISP
	# address sit there insisting it had no uplink (measured 2026-08-05).
	WAN_IF=$(ubus call network.interface.wan status 2>/dev/null | \
		 jsonfilter -e '@.l3_device' 2>/dev/null)
	[ -n "$WAN_IF" ] || return 1

	ip -br link show "$WAN_IF" 2>/dev/null | grep -q "LOWER_UP" || return 1

	src=$(ubus call network.interface.wan status 2>/dev/null | \
	      jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	[ -n "$src" ] || return 1

	# Probe the ISP's own gateway, not the open internet. A node that is
	# not (yet) the mesh gateway routes by default THROUGH the mesh, so a
	# packet aimed at 1.1.1.1 leaves the wrong way and fails even with a
	# perfectly good cable - measured on the Pro 8X, 2026-08-05. The ISP
	# gateway sits on the directly attached WAN subnet, so reaching it
	# needs no default route at all and answers the only question that
	# matters: is there a live uplink behind this cable?
	isp=$(ubus call network.interface.wan status 2>/dev/null | \
	      jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
	[ -n "$isp" ] || return 1

	# Two chances, and ARP as a second opinion: ISP routers rate-limit
	# ICMP, so a single lost echo is not evidence of a dead cable. With
	# one probe the daemon flapped - claimed, released and re-claimed the
	# address within a minute, which looked from the mesh like 60% packet
	# loss on a link that was in fact running at 1152 Mbit/s (2026-08-05).
	ping -c 2 -W 2 -I "$WAN_IF" "$isp" >/dev/null 2>&1 && return 0
	arping -c 2 -w 3 -I "$WAN_IF" "$isp" >/dev/null 2>&1 && return 0
	return 1
}

claim() {
	have_vip && return 0

	# Two cables plugged in at once: whoever holds the address keeps it,
	# unless our LAN address sorts lower (a stable, arbitrary tie-break -
	# the same job VRRP does with priorities). Without this both nodes
	# would answer for the VIP and the ARP cache would decide at random.
	if arping -D -c 2 -w 3 -I "$LAN" "$VIP" >/dev/null 2>&1; then
		: # nobody answered, the address is free
	else
		my=$(ip -4 -br addr show dev "$LAN" | awk '{print $3}' | cut -d/ -f1)
		peer=$(ip neigh show "$VIP" 2>/dev/null | awk '{print $5}')
		log "VIP already held (by $peer); standing by as backup ($my)"
		return 1
	fi

	ip addr add "$VIP/24" dev "$LAN" 2>/dev/null || return 1
	# Tell everyone the address moved; this is what makes it seamless.
	arping -c 3 -A -I "$LAN" "$VIP" >/dev/null 2>&1

	# Stop routing out through the mesh - we ARE the way out now. The
	# static default over br-lan is what every node uses to reach the
	# gateway; on the gateway itself it would compete with the route the
	# ISP's DHCP just installed, and which of the two wins is a coin toss.
	ip route del default via "$VIP" dev "$LAN" 2>/dev/null
	ip route del default via "$GW_FALLBACK" dev "$LAN" 2>/dev/null

	# ...and install the way out ourselves. netifd will not always do it:
	# with a static lan gateway already in the table the DHCP route can be
	# skipped, and the node then holds the VIP with no route at all - the
	# whole mesh points at a gateway that cannot forward (2026-08-05).
	isp=$(ubus call network.interface.wan status 2>/dev/null | \
	      jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
	[ -n "$isp" ] && ip route replace default via "$isp" dev "$WAN_IF" 2>/dev/null

	log "claimed $VIP (uplink up on $WAN_IF via $isp)"
}

release() {
	have_vip || return 0
	ip addr del "$VIP/24" dev "$LAN" 2>/dev/null
	log "released $VIP (no uplink)"
}

# Every node that is not the gateway reaches the internet through the VIP.
# Kept as a separate step from release() because a node that never had the
# cable needs it too - it is simply the normal state of a mesh node.
follow_vip() {
	have_vip && return 0
	ip route show default | grep -q "via $VIP" && return 0
	# Only if our own uplink is not the way out; otherwise leave the
	# ISP route alone (this is the gateway node between two probes).
	ip route show default | grep -q "dev $WAN_IF\|dev br-wan" && return 0
	ip route replace default via "$VIP" dev "$LAN" 2>/dev/null && \
		log "routing out through $VIP"
}

# Hand the address back on the way out. Without this a stopped daemon would
# leave the VIP behind on a node that no longer watches it, and the next
# node to take over would find the address "already held" - by a ghost.
cleanup() { release; exit 0; }
trap cleanup INT TERM

fails=0
log "started: VIP=$VIP lan=$LAN wan=$WAN_IF probe=$PROBE"

while :; do
	if uplink_ok; then
		fails=0
		claim
	else
		fails=$((fails + 1))
		if [ "$fails" -ge "$FAILS_TO_DROP" ]; then
			release
			follow_vip
		fi
	fi
	sleep "$PERIOD"
done
