#!/bin/sh
# Make sure wifimngr is attached to the hostapd control sockets that EXIST NOW.
#
# wifimngr starts at S95 and reads /etc/wifi.json there, but hostapd is still
# bringing BSSes up - 5 GHz alone waits out a 60 s DFS CAC. Measured on bpi-x8
# after a cold boot, 2026-08-04: wifimngr at ~42 s, ap-mld-1_linkN sockets at
# ~86-93 s.
#
# Two different failures come out of that, and only the first one is obvious:
#
#   1. No socket at all when the source registers. libwifi then registers it
#      DORMANT (hapdctrl_register_event leaves fd_monitor at 0), wifimngr adds
#      no uloop fd, nothing polls it and it never re-attaches. wifimngr sits at
#      one socket, its ubus connection.
#
#   2. A socket existed, but hostapd REPLACED it afterwards when the BSS came
#      up. wifimngr keeps the fd to the old, now-unlinked socket. It still
#      counts as an open socket - so a socket census says "healthy" - but no
#      event will ever arrive on it again.
#
# The second one is what the first version of this script missed. It counted
# sockets, found 13 of them, and declared the node fine while not one event was
# being delivered. Found on 2026-08-04 only because a client roamed and the
# ctrl-socket probe saw AP-STA-DISCONNECTED that never became a ubus wifi.sta.
# Restarting wifimngr by hand made events flow immediately.
#
# So compare TIMES, not counts: if any hostapd control socket is younger than
# the running wifimngr, that wifimngr cannot be attached to it. Restart once.
#
# Runs detached from S99 so it can wait out the CAC without holding up the boot.
#
# To disable: remove /etc/rc.d/S99evsrc-check. Everything reverts to polling.

WAIT_MAX=300		# > DFS CAC (60 s), with margin for 6 GHz
STEP=5
TAG=evsrc-check
DIR=/var/run/hostapd

want=$(jsonfilter -i /etc/wifi.json -e '@.events[*].ifname' 2>/dev/null | wc -l)
if [ "${want:-0}" -eq 0 ]; then
	logger -t "$TAG" "no event map, nothing to verify"
	exit 0
fi

# Wait until hostapd has published as many sockets as the map asks for.
waited=0
while [ "$waited" -lt "$WAIT_MAX" ]; do
	have=$(ls "$DIR" 2>/dev/null | grep -vc '^global$')
	[ "${have:-0}" -ge "$want" ] && break
	sleep "$STEP"
	waited=$((waited + STEP))
done

# Let a socket that has just appeared settle before reading its timestamp.
sleep "$STEP"

pid=$(ps w | grep '[/]usr/sbin/wifimngr' | awk '{print $1}' | head -1)
if [ -z "$pid" ]; then
	logger -t "$TAG" "wifimngr is not running"
	exit 0
fi

now=$(date +%s)
up=$(cut -d. -f1 /proc/uptime)

# /proc/<pid>/stat field 22 is start time in clock ticks since boot (USER_HZ
# is 100 on this kernel), so this is the wall-clock second wifimngr started.
started=$(( now - up + $(awk '{print $22}' "/proc/$pid/stat") / 100 ))

newest=0
for s in "$DIR"/*; do
	case "$s" in */global) continue ;; esac
	[ -e "$s" ] || continue
	m=$(date -r "$s" +%s 2>/dev/null) || continue
	[ "${m:-0}" -gt "$newest" ] && newest=$m
done

if [ "$newest" -le "$started" ]; then
	# Every socket predates wifimngr, so its registrations point at sockets
	# that are still the live ones.
	exit 0
fi

logger -t "$TAG" "wifimngr started at $started, newest hostapd socket is $newest ($((newest - started))s later) - it cannot be attached to it; restarting"

/etc/init.d/wifimngr restart >/dev/null 2>&1
sleep 5

pid=$(ps w | grep '[/]usr/sbin/wifimngr' | awk '{print $1}' | head -1)
socks=$(ls -l "/proc/$pid/fd" 2>/dev/null | grep -c socket)
logger -t "$TAG" "after restart: $socks socket(s) for $want event source(s)"
