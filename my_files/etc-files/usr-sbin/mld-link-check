#!/bin/sh
# Recover an AP-MLD that lost a link to the boot race.
#
# hostapd can be handed a phy before netifd has created that radio's
# interfaces; the log shows "Interface wlanX wasn't started" followed by
# "hostapd.add_iface failed for phy phyN". The affected band is then simply
# absent from the MLD, and a plain "wifi reload" does not recover it - only a
# full down/up does. Observed on the 6 GHz radio of bpi-x8, 2026-07-21.
#
# Runs once per boot from /etc/init.d/mld-link-check. Deliberately does nothing
# at runtime: a wifi restart is far too blunt to trigger on a live mesh.

RECHECK=15
# hostapd needs longer than a recheck to bring every link back after a restart;
# measuring too early makes the confirmation line under-report.
SETTLE_AFTER_RESTART=40

ifname="$(uci -q get wireless.mld0.ifname)"
[ -n "$ifname" ] || exit 0

want="$(uci -q get wireless.ap_mld_1.device | wc -w)"
[ "$want" -gt 1 ] 2>/dev/null || exit 0

links() {
	ubus call "wifi.apmld.$ifname" status 2>/dev/null | grep -c '"enabled": true'
}

have="$(links)"
[ "$have" -lt "$want" ] 2>/dev/null || exit 0

# Confirm it is not merely slow before reaching for the hammer.
sleep "$RECHECK"
have="$(links)"
[ "$have" -lt "$want" ] 2>/dev/null || exit 0

logger -t mld-link-check "AP-MLD $ifname has $have of $want links - restarting wifi once"
wifi down
sleep 5
wifi up

sleep "$SETTLE_AFTER_RESTART"
logger -t mld-link-check "AP-MLD $ifname now has $(links) of $want links"
